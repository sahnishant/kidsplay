{
  "schemaVersion": 1,
  "policy": {
    "defaultStatus": "blocked_until_reviewed",
    "allowedSourceStatuses": [
      "approved"
    ],
    "bundledPathPrefix": "public/assets/open/",
    "requiredForBundledAsset": [
      "id",
      "visualRefs",
      "sourceId",
      "sourceRevision",
      "sourcePathOrName",
      "sourceBlobSha",
      "localPath",
      "license",
      "attributionRequired",
      "modificationStatus"
    ]
  },
  "sources": [
    {
      "id": "microsoft-fluent-emoji",
      "repository": "https://github.com/microsoft/fluentui-emoji",
      "revision": "1ffb34c752ecf5d402f04cfb4b392c77f57c54bc",
      "license": "MIT",
      "licenseUrl": "https://github.com/microsoft/fluentui-emoji/blob/1ffb34c752ecf5d402f04cfb4b392c77f57c54bc/LICENSE",
      "status": "approved",
      "intendedUse": "Static semantic animals, plants, food, body, nature and everyday-object SVG artwork",
      "attributionRequired": false,
      "redistributionNoticeRequired": true,
      "licenseFile": "public/assets/open/fluent/LICENSE-MIT.txt",
      "notes": "Reviewed against the pinned repository revision. Bundle only exact verified files; do not download the upstream pack during builds."
    },
    {
      "id": "kenney-assets",
      "repository": "https://kenney.nl/assets",
      "license": "CC0-1.0",
      "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
      "reviewEvidence": "https://kenney.nl/support",
      "status": "approved",
      "intendedUse": "Optional lightweight game/object artwork where an exact Kenney asset-pack path and version are recorded",
      "attributionRequired": false,
      "redistributionNoticeRequired": false,
      "notes": "Kenney's official support page states game assets on asset pages are public-domain licensed under CC0 and attribution is not required. Each imported item still needs exact pack provenance."
    },
    {
      "id": "tabler-icons",
      "repository": "https://github.com/tabler/tabler-icons",
      "license": "MIT",
      "status": "approved",
      "intendedUse": "Utility/object/interaction SVG icons, not primary child characters",
      "attributionRequired": false,
      "notes": "Repository describes the icon set as MIT-licensed. Preserve the MIT license if assets are redistributed."
    },
    {
      "id": "jdecked-twemoji",
      "repository": "https://github.com/jdecked/twemoji",
      "license": "CC-BY-4.0 graphics",
      "status": "candidate",
      "intendedUse": "Consistent lightweight animal/object SVGs when attribution is acceptable",
      "attributionRequired": true,
      "notes": "The repository code has separate licensing; graphics are explicitly covered by LICENSE-GRAPHICS under CC-BY-4.0."
    },
    {
      "id": "googlefonts-noto-emoji",
      "repository": "https://github.com/googlefonts/noto-emoji",
      "license": "OFL-1.1 repository metadata; verify exact asset path before import",
      "status": "candidate",
      "intendedUse": "Possible consistent emoji-style animal/object visual source",
      "attributionRequired": true,
      "notes": "Repository metadata reports OFL-1.1. No asset-level license is asserted until a specific source path is verified."
    },
    {
      "id": "game-icons",
      "repository": "https://github.com/game-icons/icons",
      "license": "Per-asset / repository reports NOASSERTION",
      "status": "reference_only",
      "intendedUse": "Mechanic and symbol inspiration only until exact icon author/license is recorded",
      "attributionRequired": true,
      "notes": "Never bulk-import this repository. Each selected asset needs its exact author and license checked."
    },
    {
      "id": "platform-unicode-emoji",
      "repository": null,
      "license": "Platform-rendered glyph; no Kidsplay artwork redistributed",
      "status": "approved",
      "intendedUse": "Prototype/fallback only",
      "attributionRequired": false,
      "notes": "Visual appearance varies by Android/browser/platform, so this is not the long-term character system."
    }
  ],
