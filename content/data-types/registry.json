{
  "schemaVersion": 1,
  "dataTypes": [
    {
      "id": "choice_item",
      "version": 1,
      "description": "A pre-authored prompt with choices and one correct choice.",
      "compatibleEngines": ["single_choice@1"],
      "engineRequirements": {
        "single_choice@1": { "minUnits": 1, "minChoices": 2, "recipeUnitMode": "all" }
      }
    },
    {
      "id": "association_set",
      "version": 1,
      "description": "A reusable set of subject-relation-object associations.",
      "compatibleEngines": [
        "single_choice@1",
        "word_bank_fill@1",
        "drag_to_target@1",
        "memory_pairs@1",
        "word_search@1",
        "sequence_order@1",
        "crossword@1",
        "print_cards@1"
      ],
      "engineRequirements": {
        "single_choice@1": { "minUnits": 2, "recipeUnitMode": "single" },
        "word_bank_fill@1": { "minUnits": 2, "recipeUnitMode": "single" },
        "drag_to_target@1": { "minUnits": 2, "recipeUnitMode": "set" },
        "memory_pairs@1": { "minUnits": 2, "recipeUnitMode": "set" },
        "word_search@1": { "minUnits": 2, "recipeUnitMode": "set" },
        "sequence_order@1": { "minUnits": 1, "recipeUnitMode": "single" },
        "crossword@1": { "minUnits": 2, "recipeUnitMode": "set" },
        "print_cards@1": { "minUnits": 1, "recipeUnitMode": "set" }
      }
    },
    {
      "id": "process",
      "version": 1,
      "description": "One canonical ordered process or state transition with stable stages.",
      "compatibleEngines": ["sequence_order@1"],
      "engineRequirements": {
        "sequence_order@1": { "minUnits": 1, "recipeUnitMode": "all" }
      }
    }
  ]
}
