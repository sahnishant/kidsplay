{
  "name": "kidsplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:index": "node scripts/build-content-index.mjs",
    "compile:content": "node scripts/compile-knowledge.mjs && node scripts/build-content-index.mjs && node scripts/compile-crosswords.mjs && node scripts/compile-mazes.mjs && node scripts/generate-asset-notices.mjs",
    "query:content": "npm run compile:index && node scripts/query-content.mjs",
    "plan:profile": "npm run compile:index && node scripts/plan-profile.mjs",
    "render:profile-output": "npm run compile:index && node scripts/render-profile-output.mjs",
    "lexicon:extract:oewn": "node scripts/lexicon/extract-oewn-candidates.mjs",
    "lexicon:sync:primary": "node scripts/lexicon/sync-primary-grade-corpus.mjs",
    "lexicon:select:primary": "node scripts/lexicon/select-grade-vocabulary.mjs",
    "lexicon:resolve:primary": "node scripts/lexicon/build-grade-sense-review.mjs",
    "lexicon:profile-slice:primary": "node scripts/lexicon/build-primary-vocabulary-profile-slice.mjs",
    "lexicon:reband:primary": "node scripts/lexicon/reband-primary-grade-corpus.mjs",
    "lexicon:export:review-slice": "node scripts/lexicon/export-primary-vocabulary-sense-slice.mjs",
    "lexicon:prepare:editorial": "node scripts/lexicon/prepare-primary-vocabulary-editorial-packet.mjs",
    "lexicon:finalize:editorial": "node scripts/lexicon/finalize-primary-vocabulary-editorial-packet.mjs",
    "lexicon:prepare:editorial:grade1": "npm run lexicon:prepare:editorial -- --slice content/lexicon/open/curator-slices/grade-1-meaning-review.json --output content/lexicon/editorial-packets/grade-1-batch-001.json --batch-id grade-1-batch-001 --profile-targets CBSE_INDIA_CLASS1,CISCE_INDIA_CLASS1",
    "lexicon:prepare:editorial:grade2": "npm run lexicon:prepare:editorial -- --slice content/lexicon/open/curator-slices/grade-2-meaning-review.json --output content/lexicon/editorial-packets/grade-2-batch-001.json --batch-id grade-2-batch-001 --profile-targets CBSE_INDIA_CLASS2,CISCE_INDIA_CLASS2,SOF_INDIA_CLASS2",
    "lexicon:import:reviews": "node scripts/lexicon/import-primary-vocabulary-reviews.mjs",
    "report:lexicon-corpus": "node scripts/lexicon/report-primary-grade-corpus.mjs",
    "report:sof-row-review": "node scripts/report-sof-row-review.mjs",
    "report:coverage": "node scripts/report-learning-coverage.mjs",
    "report:profile": "node scripts/report-learning-coverage.mjs",
    "report:class3": "node scripts/report-learning-coverage.mjs --profile=SOF_INDIA_CLASS3",
    "report:class4": "node scripts/report-learning-coverage.mjs --profile=SOF_INDIA_CLASS4",
    "report:class5": "node scripts/report-learning-coverage.mjs --profile=SOF_INDIA_CLASS5",
    "report:class6": "node scripts/report-learning-coverage.mjs --profile=SOF_INDIA_CLASS6",
    "report:class3-scope": "node scripts/report-profile-scope.mjs --profile=SOF_INDIA_CLASS3",
    "report:class4-scope": "node scripts/report-profile-scope.mjs --profile=SOF_INDIA_CLASS4",
    "report:class5-scope": "node scripts/report-profile-scope.mjs --profile=SOF_INDIA_CLASS5",
    "report:class6-scope": "node scripts/report-profile-scope.mjs --profile=SOF_INDIA_CLASS6",
    "report:upper-primary-scope": "npm run report:class3-scope && npm run report:class4-scope && npm run report:class5-scope && npm run report:class6-scope",
    "report:profile-maturity": "npm run compile:content && node scripts/report-profile-maturity.mjs --profiles=SOF_INDIA_CLASS2,SOF_INDIA_CLASS3,SOF_INDIA_CLASS4,SOF_INDIA_CLASS5,SOF_INDIA_CLASS6",
    "report:profile-maturity:compiled": "node scripts/report-profile-maturity.mjs --profiles=SOF_INDIA_CLASS2,SOF_INDIA_CLASS3,SOF_INDIA_CLASS4,SOF_INDIA_CLASS5,SOF_INDIA_CLASS6 --fail-on-uncovered",
    "report:visual-coverage": "node scripts/report-visual-coverage.mjs --fail-under=40",
    "report:visual-opportunities": "node scripts/report-visual-opportunities.mjs --profile=SOF_INDIA_CLASS2 --limit=12 --fail-on-unreviewed-concrete",
    "report:class3-visual-opportunities": "node scripts/report-visual-opportunities.mjs --profile=SOF_INDIA_CLASS3 --limit=20",
    "report:visual-opportunities:all": "node scripts/report-visual-opportunities.mjs --limit=12",
    "report:semantic-animation": "node scripts/report-semantic-animation-coverage.mjs",
    "validate:engines": "node scripts/validate-engine-registry.mjs",
    "validate:scenes": "node scripts/validate-scenes.mjs",
    "validate:animations": "node scripts/validate-animations.mjs",
    "validate:visuals": "node scripts/validate-visuals.mjs",
    "validate:story": "node scripts/validate-story.mjs",
    "validate:planner": "node scripts/validate-planner.mjs",
    "validate:outputs": "node scripts/validate-output-engines.mjs",
    "validate:taxonomies": "node scripts/validate-taxonomies.mjs",
    "validate:alignment-terminal-reviews": "node scripts/validate-alignment-terminal-reviews.mjs",
    "validate:alignment": "node scripts/validate-alignment.mjs && node scripts/validate-profile-inheritance.mjs && node scripts/validate-alignment-reviews.mjs && node scripts/validate-alignment-recovery.mjs && npm run validate:alignment-terminal-reviews",
    "validate:profile-composition": "node scripts/validate-profile-composition.mjs",
    "validate:pack-composition": "node scripts/validate-pack-composition.mjs",
    "validate:profile-scope-targets": "node scripts/validate-profile-scope-targets.mjs",
    "validate:blueprints": "node scripts/validate-assessment-blueprints.mjs",
    "validate:traceability": "node scripts/validate-knowledge-traceability.mjs",
    "validate:production-profile-maturity": "node scripts/validate-production-profile-maturity.mjs",
    "validate:lexicon-corpus": "node scripts/lexicon/validate-primary-grade-corpus.mjs",
    "validate:lexicon-senses": "node scripts/lexicon/validate-grade-sense-review.mjs",
    "validate:product": "node scripts/validate-product-catalog.mjs",
    "validate:bundle": "node scripts/validate-bundle-budget.mjs",
    "dev": "npm run compile:content && vite",
    "preview": "vite preview",
    "validate:content": "npm run compile:content && npm run validate:engines && npm run validate:scenes && npm run validate:animations && npm run validate:visuals && npm run report:semantic-animation && npm run validate:story && npm run validate:taxonomies && npm run validate:alignment && npm run validate:profile-composition && npm run validate:pack-composition && npm run validate:profile-scope-targets && npm run validate:blueprints && npm run validate:planner && npm run validate:outputs && npm run validate:traceability && npm run validate:lexicon-corpus && npm run validate:product && npm run report:coverage && npm run report:upper-primary-scope && npm run report:profile-maturity:compiled && npm run validate:production-profile-maturity && npm run report:class3-visual-opportunities && npm run report:visual-coverage && npm run report:visual-opportunities && node scripts/validate-content.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run compile:content && vitest run",
    "test:run": "vitest run",
    "test:vocabulary-corpus": "npm run compile:content && vitest run tests/lexicon-import.behavior.test.ts tests/primary-vocabulary-corpus.behavior.test.ts tests/primary-vocabulary-mandate.behavior.test.ts tests/primary-vocabulary-editorial-packets.behavior.test.ts tests/vocabulary-delivery.behavior.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "build": "npm run validate:content && npm run typecheck && vite build && npm run validate:bundle",
    "check": "npm run build && npm run test:run",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "svelte": "5.56.10"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.0.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
