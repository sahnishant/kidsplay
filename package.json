{
  "name": "kidsplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:index": "node scripts/build-content-index.mjs",
    "compile:content": "node scripts/compile-knowledge.mjs && node scripts/build-content-index.mjs && node scripts/compile-crosswords.mjs && node scripts/compile-mazes.mjs && node scripts/generate-asset-notices.mjs",
    "query:content": "npm run compile:index && node scripts/query-content.mjs",
    "plan:profile": "npm run compile:index && node scripts/plan-profile.mjs",
    "render:profile-output": "npm run compile:index && node scripts/render-profile-output.mjs",
    "lexicon:extract:oewn": "node scripts/lexicon/extract-oewn-candidates.mjs",
    "lexicon:sync:primary": "node scripts/lexicon/sync-primary-grade-corpus.mjs",
    "lexicon:select:primary": "node scripts/lexicon/select-grade-vocabulary.mjs",
    "lexicon:resolve:primary": "node scripts/lexicon/build-grade-sense-review.mjs",
    "lexicon:profile-slice:primary": "node scripts/lexicon/build-primary-vocabulary-profile-slice.mjs",
    "report:lexicon-corpus": "node scripts/lexicon/report-primary-grade-corpus.mjs",
    "report:coverage": "node scripts/report-learning-coverage.mjs",
    "report:profile-maturity": "npm run compile:content && node scripts/report-profile-maturity.mjs --profiles=SOF_INDIA_CLASS2,SOF_INDIA_CLASS3",
    "report:profile-maturity:compiled": "node scripts/report-profile-maturity.mjs --profiles=SOF_INDIA_CLASS2,SOF_INDIA_CLASS3 --fail-on-uncovered",
    "report:visual-coverage": "node scripts/report-visual-coverage.mjs --fail-under=40",
    "report:visual-opportunities": "node scripts/report-visual-opportunities.mjs --profile=SOF_INDIA_CLASS2 --limit=12 --fail-on-unreviewed-concrete",
    "report:visual-opportunities:all": "node scripts/report-visual-opportunities.mjs --limit=12",
    "validate:engines": "node scripts/validate-engine-registry.mjs",
    "validate:scenes": "node scripts/validate-scenes.mjs",
    "validate:visuals": "node scripts/validate-visuals.mjs",
    "validate:story": "node scripts/validate-story.mjs",
    "validate:planner": "node scripts/validate-planner.mjs",
    "validate:outputs": "node scripts/validate-output-engines.mjs",
    "validate:taxonomies": "node scripts/validate-taxonomies.mjs",
    "validate:alignment": "node scripts/validate-alignment.mjs && node scripts/validate-profile-inheritance.mjs && node scripts/validate-alignment-reviews.mjs",
    "validate:blueprints": "node scripts/validate-assessment-blueprints.mjs",
    "validate:traceability": "node scripts/validate-knowledge-traceability.mjs",
    "validate:lexicon-corpus": "node scripts/lexicon/validate-primary-grade-corpus.mjs",
    "validate:lexicon-senses": "node scripts/lexicon/validate-grade-sense-review.mjs",
    "validate:product": "node scripts/validate-product-catalog.mjs",
    "validate:bundle": "node scripts/validate-bundle-budget.mjs",
    "dev": "npm run compile:content && vite",
    "preview": "vite preview",
    "validate:content": "npm run compile:content && npm run validate:engines && npm run validate:scenes && npm run validate:visuals && npm run validate:story && npm run validate:taxonomies && npm run validate:alignment && npm run validate:blueprints && npm run validate:planner && npm run validate:outputs && npm run validate:traceability && npm run validate:lexicon-corpus && npm run validate:product && npm run report:coverage && npm run report:profile-maturity:compiled && npm run report:visual-coverage && npm run report:visual-opportunities && node scripts/validate-content.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run compile:content && vitest run",
    "test:run": "vitest run",
    "test:vocabulary-corpus": "npm run compile:content && vitest run tests/lexicon-import.behavior.test.ts tests/primary-vocabulary-corpus.behavior.test.ts tests/vocabulary-delivery.behavior.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "build": "npm run validate:content && npm run typecheck && vite build && npm run validate:bundle",
    "check": "npm run build && npm run test:run",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "svelte": "5.56.10"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.0.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
